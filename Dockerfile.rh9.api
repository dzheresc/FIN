# Dockerfile for RedHat 9 - API Service
FROM registry.access.redhat.com/ubi9/ubi:latest

# Install runtime dependencies
RUN dnf install -y \
    libstdc++ \
    && dnf clean all

# Copy built binary (assumes build stage)
COPY --from=builder /app/build/api_service_cpp /usr/local/bin/api_service

# Expose port
EXPOSE 5000

# Set working directory
WORKDIR /app

# Default command
CMD ["/usr/local/bin/api_service", "5000"]

